    function arrangeAll() {
      const pos = {
        'win-mypc': [60, 220],
        'win-trash': [100, 260],
        'win-case': [24, 200],
        'win-suspects': [85, 520],
        'win-locker': [55, 240],
        'win-final': [80, 190],
        'win-truth': [40, 230]
      };
      Object.entries(pos).forEach(([id, [t, l]]) => {
        const el = document.getElementById(id);
        el.classList.remove('maximized');
        el.style.top = t + 'px';
        el.style.left = l + 'px';
      });
