              ${cipherSolved ? '✅ 해독 완료: “타인과 만남” (C, D 용의자 제외) <button class="xp-btn primary" style="margin-left:8px;" onclick="openWin(\'win-final\')">⚖️ 최종_심문 열기</button>' : ''}
