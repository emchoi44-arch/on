      addrEl.textContent = '📁 C:\\온점_동아리\\잠금폴더\\편지.txt';

      body.innerHTML = `
        <div class="notepad-page">
          <div style="font-size:12px; color:#155724; background:#eef9f0; border:1px solid #2e8540; padding:6px 10px; margin-bottom:10px;">
            🔓 잠금폴더가 열렸습니다. 폴더 안에서 <strong>익명의 편지</strong>를 발견했습니다.
          </div>

