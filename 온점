<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>온점 동아리실 PC (ONJEOM-PC)</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Malgun Gothic', '맑은 고딕', 'Apple SD Gothic Neo', sans-serif;
      height: 100vh;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 50% 115%, #3d7a2b 0%, #2f6421 28%, transparent 52%),
        radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.45) 0%, transparent 35%),
        radial-gradient(circle at 75% 28%, rgba(255, 255, 255, 0.35) 0%, transparent 30%),
        linear-gradient(180deg, #2a70c9 0%, #5ea2eb 48%, #98cbf8 72%, #4c8c38 73%, #2b5d1d 100%);
      user-select: none;
    }

    /* Desktop Area */
    #desktop {
      position: relative;
      width: 100%;
      height: calc(100vh - 34px);
      overflow: hidden;
    }

    /* Desktop Icons */
    .desktop-icons {
      position: absolute;
      top: 14px;
      left: 14px;
      display: grid;
      grid-template-rows: repeat(6, auto);
      grid-auto-flow: column;
      gap: 12px 18px;
      z-index: 1;
    }

    .win-icon {
      width: 78px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      padding: 5px 4px;
      border: 1px solid transparent;
      border-radius: 3px;
      cursor: pointer;
      text-align: center;
    }

    .win-icon:hover {
      background: rgba(11, 97, 255, 0.25);
      border: 1px dotted rgba(255, 255, 255, 0.75);
    }

    .win-icon-img {
      width: 36px;
      height: 36px;
      font-size: 28px;
      line-height: 36px;
      filter: drop-shadow(1px 2px 2px rgba(0, 0, 0, 0.45));
      position: relative;
    }

    .win-icon-img.locked::after {
      content: '🔒';
      position: absolute;
      bottom: -3px;
      right: -6px;
      font-size: 13px;
      line-height: 1;
    }

    .win-icon-label {
      font-size: 11.5px;
      color: #ffffff;
      text-shadow: 1px 1px 2px #000, 0 0 3px #000;
      line-height: 1.25;
      word-break: keep-all;
    }

    /* Classic Windows XP / Classic Window */
    .xp-window {
      position: absolute;
      background: #ece9d8;
      border: 2px solid #0054e3;
      border-radius: 6px 6px 2px 2px;
      box-shadow: 3px 5px 16px rgba(0, 0, 0, 0.45);
      display: none;
      flex-direction: column;
      min-width: 320px;
      max-width: 95vw;
      max-height: calc(100vh - 54px);
      overflow: hidden;
      user-select: text;
    }

    .xp-window.open {
      display: flex;
    }

    .xp-window.minimized {
      display: none !important;
    }

    .xp-window.maximized {
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: calc(100vh - 34px) !important;
      max-width: 100% !important;
      max-height: calc(100vh - 34px) !important;
      border-radius: 0;
    }

    .xp-window.inactive {
      border-color: #7b96ce;
    }

    .xp-titlebar {
      height: 28px;
      background: linear-gradient(180deg, #3b8aff 0%, #0058ee 15%, #0055ea 85%, #003cb3 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 5px 0 8px;
      cursor: move;
      flex-shrink: 0;
      user-select: none;
    }

    .xp-window.inactive .xp-titlebar {
      background: linear-gradient(180deg, #9db9eb 0%, #7a96df 100%);
    }

    .xp-title {
      font-size: 12.5px;
      font-weight: 700;
      text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .xp-win-btns {
      display: flex;
      gap: 2px;
      flex-shrink: 0;
    }

    .xp-ctrl {
      width: 21px;
      height: 21px;
      border: 1px solid #ffffff;
      border-radius: 3px;
      background: linear-gradient(180deg, #6ba7ff 0%, #1c64e0 100%);
      color: #ffffff;
      font-size: 12px;
      font-weight: 700;
      line-height: 18px;
      text-align: center;
      cursor: pointer;
    }

    .xp-ctrl:hover {
      filter: brightness(1.12);
    }

    .xp-ctrl.close {
      background: linear-gradient(180deg, #f38873 0%, #d8361c 100%);
    }

    /* Menu Bar & Address Bar */
    .menubar {
      background: #ece9d8;
      border-bottom: 1px solid #aca899;
      padding: 2px 8px;
      font-size: 11.5px;
      color: #000;
      display: flex;
      gap: 12px;
      flex-shrink: 0;
    }

    .menubar span {
      padding: 1px 4px;
    }

    .menubar span:hover {
      background: #316ac5;
      color: #fff;
    }

    .address-bar {
      background: #ece9d8;
      border-bottom: 1px solid #aca899;
      padding: 4px 8px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      flex-shrink: 0;
    }

    .address-input {
      flex: 1;
      background: #ffffff;
      border: 1px solid #7f9db9;
      padding: 2px 6px;
      font-size: 12px;
      color: #000;
    }

    /* Window Inner Content */
    .xp-body {
      flex: 1;
      overflow-y: auto;
      font-size: 13.5px;
      line-height: 1.65;
      color: #111;
    }

    .notepad-page {
      background: #ffffff;
      padding: 16px 18px;
      min-height: 100%;
      font-size: 13.5px;
    }

    .dialog-page {
      background: #ece9d8;
      padding: 14px 16px;
      min-height: 100%;
    }

    .group-box {
      border: 1px solid #d0ccc0;
      box-shadow: inset 1px 1px 0 #fff;
      border-radius: 4px;
      padding: 12px;
      margin-bottom: 12px;
      background: #f5f3ea;
    }

    .group-box legend {
      font-size: 12px;
      font-weight: 700;
      color: #003399;
      padding: 0 5px;
    }

    .white-box {
      background: #ffffff;
      border: 1px solid #7f9db9;
      padding: 12px 14px;
      margin: 10px 0;
    }

    /* Explorer Split Layout */
    .explorer-wrap {
      display: grid;
      grid-template-columns: 165px 1fr;
      min-height: 360px;
      height: 100%;
      background: #ffffff;
    }

    @media (max-width: 640px) {
      .explorer-wrap { grid-template-columns: 1fr; }
    }

    .explorer-left {
      background: linear-gradient(180deg, #7ba2e7 0%, #6375d6 100%);
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .task-panel {
      background: #ffffff;
      border-radius: 4px;
      overflow: hidden;
      font-size: 12px;
    }

    .task-panel-head {
      background: linear-gradient(90deg, #ffffff 0%, #c6d3f7 100%);
      color: #215dc6;
      font-weight: 700;
      padding: 5px 8px;
      font-size: 11.5px;
    }

    .task-panel-body {
      padding: 6px 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .folder-link {
      background: none;
      border: none;
      text-align: left;
      font-size: 12px;
      color: #215dc6;
      cursor: pointer;
      padding: 3px 4px;
      font-family: inherit;
      border-radius: 2px;
    }

    .folder-link:hover {
      text-decoration: underline;
      background: #eef3ff;
    }

    .folder-link.active {
      background: #316ac5;
      color: #ffffff;
      font-weight: 700;
    }

    .folder-link.excluded {
      color: #888;
      text-decoration: line-through;
    }

    .explorer-right {
      padding: 14px 16px;
      overflow-y: auto;
    }

    /* Classic Buttons & Inputs */
    .xp-btn {
      background: linear-gradient(180deg, #ffffff 0%, #ece9d8 85%, #d6d0c0 100%);
      border: 1px solid #003c74;
      border-radius: 3px;
      padding: 5px 12px;
      font-size: 12.5px;
      color: #000;
      cursor: pointer;
      font-family: inherit;
    }

    .xp-btn:hover {
      box-shadow: inset 0 0 0 1px #f7b754;
    }

    .xp-btn:active {
      background: #dcd8c8;
    }

    .xp-btn.primary {
      font-weight: 700;
      box-shadow: inset 0 0 0 1px #5787d6;
    }

    .xp-btn.danger {
      border-color: #9b1c1c;
      color: #9b1c1c;
      font-weight: 700;
    }

    .xp-input {
      background: #ffffff;
      border: 1px solid #7f9db9;
      padding: 6px 9px;
      font-size: 13.5px;
      font-family: inherit;
      color: #000;
    }

    .xp-input:focus {
      outline: 1px solid #0054e3;
    }

    /* Quiz Options */
    .quiz-item {
      background: #ffffff;
      border: 1px solid #aca899;
      padding: 10px 12px;
      margin-bottom: 8px;
    }

    .quiz-opts {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
    }

    .quiz-opt {
      background: #f5f4ee;
      border: 1px solid #7f9db9;
      padding: 4px 9px;
      font-size: 12px;
      cursor: pointer;
      font-family: inherit;
    }

    .quiz-opt.picked {
      background: #316ac5;
      color: #ffffff;
      border-color: #003c74;
      font-weight: 700;
    }

    /* Letter Lines */
    .letter-scroll {
      overflow-x: auto;
    }

    .letter-line {
      padding: 3px 0;
      font-size: 13.5px;
      white-space: nowrap;
    }

    /* Statement Cards */
    .stmt-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 10px;
    }

    @media (max-width: 700px) {
      .stmt-grid { grid-template-columns: 1fr; }
    }

    .stmt-box {
      background: #ffffff;
      border: 1px solid #7f9db9;
      padding: 12px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
    }

    /* Feedback Box */
    .sys-alert {
      margin-top: 10px;
      padding: 9px 12px;
      border: 1px solid #aca899;
      font-size: 12.5px;
      display: none;
      line-height: 1.6;
    }

    .sys-alert.err {
      display: block;
      background: #fff0f0;
      border-color: #cc0000;
      color: #990000;
    }

    .sys-alert.ok {
      display: block;
      background: #eef9f0;
      border-color: #2e8540;
      color: #155724;
    }

    .sys-alert.hint {
      display: block;
      background: #fffbe6;
      border-color: #d4a017;
      color: #664d03;
    }

    /* Taskbar */
    #xp-taskbar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 34px;
      background: linear-gradient(180deg, #3168d5 0%, #245edb 12%, #1941a5 100%);
      border-top: 1px solid #5995ff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 9999;
    }

    .task-left {
      display: flex;
      align-items: center;
      height: 100%;
      overflow-x: auto;
      gap: 4px;
    }

    .start-btn {
      height: 100%;
      padding: 0 14px 0 10px;
      background: linear-gradient(180deg, #52b749 0%, #3b9c33 20%, #2b7e24 90%, #1d5d17 100%);
      border: none;
      border-right: 1px solid #164811;
      border-radius: 0 10px 10px 0;
      color: #ffffff;
      font-size: 13.5px;
      font-weight: 700;
      font-style: italic;
      text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.55);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .start-btn:hover {
      filter: brightness(1.08);
    }

    .task-win-btn {
      height: 25px;
      max-width: 155px;
      padding: 0 10px;
      background: linear-gradient(180deg, #4f85ee 0%, #2c62d0 100%);
      border: 1px solid #1b439c;
      border-radius: 3px;
      color: #ffffff;
      font-size: 12px;
      cursor: pointer;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-family: inherit;
    }

    .task-win-btn.active {
      background: linear-gradient(180deg, #1b439c 0%, #2857bd 100%);
      box-shadow: inset 1px 1px 3px rgba(0, 0, 0, 0.45);
      font-weight: 700;
    }

    .system-tray {
      height: 100%;
      background: linear-gradient(180deg, #1290e8 0%, #0d72c9 100%);
      border-left: 1px solid #095299;
      padding: 0 10px;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #ffffff;
      font-size: 11.5px;
      flex-shrink: 0;
    }

    .tray-sound-btn {
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 3px;
      color: #ffffff;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 7px;
      cursor: pointer;
      font-family: inherit;
      display: flex;
      align-items: center;
      gap: 3px;
    }

    .tray-sound-btn:hover {
      background: rgba(255, 255, 255, 0.28);
    }

    .tray-sound-btn.playing {
      background: rgba(255, 255, 255, 0.92);
      color: #0d5099;
      border-color: #ffffff;
    }

    /* Start Menu Popup */
    #start-menu {
      position: fixed;
      bottom: 34px;
      left: 0;
      width: 320px;
      background: #ffffff;
      border: 2px solid #0054e3;
      border-radius: 6px 6px 0 0;
      box-shadow: 4px -4px 18px rgba(0, 0, 0, 0.45);
      display: none;
      flex-direction: column;
      z-index: 10000;
      overflow: hidden;
    }

    #start-menu.open {
      display: flex;
    }

    .start-head {
      background: linear-gradient(180deg, #1f65d6 0%, #1049ad 100%);
      color: #ffffff;
      padding: 10px 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 14px;
    }

    .start-avatar {
      width: 36px;
      height: 36px;
      background: #e5eefc;
      color: #1049ad;
      border: 2px solid #ffffff;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .start-cols {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      border-top: 1px solid #e0983b;
    }

    .start-left {
      background: #ffffff;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .start-right {
      background: #d3e5fa;
      border-left: 1px solid #95bdee;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .start-item {
      background: none;
      border: none;
      text-align: left;
      padding: 6px 8px;
      font-size: 12px;
      cursor: pointer;
      border-radius: 3px;
      font-family: inherit;
      color: #111;
    }

    .start-item:hover {
      background: #316ac5;
      color: #ffffff;
    }

    .start-foot {
      background: linear-gradient(180deg, #3c7be2 0%, #1d57ba 100%);
      padding: 6px 10px;
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      #desktop {
        overflow-y: auto;
        padding: 10px;
      }
      .desktop-icons {
        position: static;
        grid-template-rows: none;
        grid-auto-flow: row;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        margin-bottom: 12px;
      }
      .win-icon {
        width: 100%;
      }
      .xp-window {
        position: static !important;
        width: 100% !important;
        max-width: 100% !important;
        max-height: none !important;
        margin-bottom: 12px;
      }
    }
  </style>
</head>
