      if (!e.target.closest('#start-menu') && !e.target.closest('.start-btn')) {
        closeStartMenu();
      }
    });

    function setupDrag() {
      document.querySelectorAll('.xp-window').forEach(w => {
        w.addEventListener('mousedown', () => focusWin(w.id));
      });

      document.querySelectorAll('.xp-titlebar').forEach(bar => {
        bar.addEventListener('mousedown', (e) => {
          if (e.target.closest('.xp-win-btns')) return;
          if (window.innerWidth <= 768) return;

          const win = document.getElementById(bar.dataset.win);
          if (win.classList.contains('maximized')) return;
          focusWin(win.id);

          const sx = e.clientX, sy = e.clientY;
          const ol = win.offsetLeft, ot = win.offsetTop;

          function move(ev) {
            const nx = ol + (ev.clientX - sx);
            const ny = ot + (ev.clientY - sy);
            win.style.left = Math.max(-win.offsetWidth + 100, Math.min(window.innerWidth - 100, nx)) + 'px';
            win.style.top = Math.max(0, Math.min(window.innerHeight - 70, ny)) + 'px';
          }
          function up() {
            document.removeEventListener('mousemove', move);
            document.removeEventListener('mouseup', up);
          }
          document.addEventListener('mousemove', move);
          document.addEventListener('mouseup', up);
        });
      });
    }

    function updateClock() {
      const now = new Date();
      let h = now.getHours();
      const m = String(now.getMinutes()).padStart(2, '0');
      const ampm = h >= 12 ? '오후' : '오전';
      h = h % 12 || 12;
      document.getElementById('tray-clock').textContent = `${ampm} ${h}:${m}`;
    }

