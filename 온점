    function unlockLocker() {
      const code = document.getElementById('lock-input').value.trim();
      const alertBox = document.getElementById('lock-alert');
      if (code === '234') {
        lockerUnlocked = true;
        document.getElementById('ico-locker').classList.remove('locked');
        renderLockerWindow();
      } else {
        alertBox.className = 'sys-alert err';
        alertBox.textContent = '⚠ 비밀번호가 올바르지 않습니다. 퀴즈 1·2·3번의 번호를 다시 확인하세요.';
      }
    }

    function checkCipher() {
      const val = document.getElementById('cipher-input').value.replace(/[\s,.\-_]+/g, '');
      const alertBox = document.getElementById('cipher-alert');
      if (val === '타인과만남') {
        cipherSolved = true;
        document.getElementById('ico-final').classList.remove('locked');
        alertBox.className = 'sys-alert ok';
        alertBox.innerHTML = '✅ 해독 성공: <strong>“타인과 만남”</strong><br>당일 외부인 접촉 정황이 없는 <strong>C, D가 용의자에서 제외</strong>되었습니다! <button class="xp-btn primary" style="margin-top:6px;" onclick="openWin(\'win-final\')">⚖️ 최종_심문 열기</button>';
        renderSuspects();
      } else {
        alertBox.className = 'sys-alert err';
        alertBox.textContent = '⚠ 일치하지 않습니다. P.S.의 숫자들이 무엇을 의미하는지 다시 확인하거나 [힌트]를 눌러보세요.';
      }
    }

    function hintCipher() {
      if (cipherHintLevel === 0) {
        cipherHintLevel = 1;
        cipherHintVisible = true;
      } else if (cipherHintLevel === 1) {
        cipherHintLevel = 2;
        cipherHintVisible = true;
      } else {
        cipherHintVisible = !cipherHintVisible;
      }
      updateHintUI();
    }

    function updateHintUI() {
      const btn = document.getElementById('hint-btn');
      const hintBox = document.getElementById('cipher-hint-box');
      if (!btn || !hintBox) return;

      if (cipherHintLevel === 0) {
        btn.textContent = '힌트 (1/2)';
        hintBox.style.display = 'none';
      } else if (cipherHintLevel === 1) {
        btn.textContent = '추가 힌트 (2/2)';
        hintBox.style.display = 'block';
        hintBox.innerHTML =
          '💡 <strong>1차 힌트 (규칙: 줄 - 단어 - 글자):</strong> 세 숫자는 각각 편지의 <strong>[몇 번째 줄 - 몇 번째 단어 - 몇 번째 글자]</strong>를 뜻합니다. 첫 번째 줄부터 세어 단서를 조합해 보세요.';
      } else {
        btn.textContent = cipherHintVisible ? '힌트 숨기기' : '힌트 다시 보기';
        hintBox.style.display = cipherHintVisible ? 'block' : 'none';
        hintBox.innerHTML =
